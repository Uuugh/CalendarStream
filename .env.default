# ============================================================
#  CalendarStream — copy to .env:  cp .env.default .env
# ============================================================

# --- Shared host settings ---
# 1000 taichi | 1001 media | 100 users
PUID=1000
GUID=100
# Time zone (also the zone the CCS schedule times are read in)
TZ=America/New_York

MNT_ASMEDIA=/mnt/asmedia
MNT_BACKUP=/mnt/backups/docker
MNT_NAS=/mnt/NAS
MNT_SSD=/mnt/SSD
MNT_DOCKER=/mnt/SSD/docker

# Docker restart policy: no | always | unless-stopped | on-failure
RESTART=unless-stopped

# Which CalendarStream image to run (ghcr.io/uuugh/calendarstream:<IMAGE_TAG>):
#   beta   = newest release      latest = last release marked stable      0.0.2 = that exact version
IMAGE_TAG=latest

# --- CCS+ Calendar Sync ---
# Turn it on in CCS+: Settings > Schedule Settings > Calendar syncing (create a calendar password).
# Sign-in comes from Docker secrets (see docker-compose.yml):
#   /mnt/SSD/docker/.secrets/CCS_USER.txt      -> your UID
#   /mnt/SSD/docker/.secrets/CCS_PASSWORD.txt  -> the Calendar Sync password (not your CCS login)
# Leave these two blank; they're only used if the secrets are removed from docker-compose.yml.
CCS_USERNAME=
CCS_PASSWORD=
# The link from CCS+ "Copy link". You can also paste it on the status page (Setup), which wins.
CCS_CALENDAR_URL=https://ccsplus.ual.com/calendarsyncapi/api/Calendar/GetCalendar

# --- Schedule ---
# How often to download the schedule from CCS+ (minutes, minimum 15)
SYNC_INTERVAL_MINUTES=60
CALENDAR_NAME=United CCS Schedule
# Items with a start time but no end time: a number of hours (e.g. 1 or 1.5), or allday
DEFAULT_EVENT_HOURS=1
# Show timed events lasting exactly 24 h (or 48 h, 72 h…) as all-day events: true / false
ALLDAY_24H=true

# --- Feed / status page ---
# Public HTTPS address Google uses to reach this container, e.g. https://ccs.example.com
# Fill this in to remove the "not a public HTTPS address" warning.
PUBLIC_URL=
# Secret part of the feed link. Blank = auto-generated once and saved in the database.
# To keep a link you already shared, paste the old token here
# (it was in /mnt/SSD/docker/ccs_calendar/config/feed_token).
FEED_TOKEN=
# Status-page login comes from Docker secrets (see docker-compose.yml):
#   /mnt/SSD/docker/.secrets/USER.txt      -> GUI_USERNAME
#   /mnt/SSD/docker/.secrets/PASSWORD.txt  -> GUI_PASSWORD
# Leave these two blank; they're only used if the secrets are removed from docker-compose.yml.
GUI_USERNAME=
GUI_PASSWORD=

# --- Database (Postgres container calendar_stream_db) ---
# All project data is stored here. Files live in /mnt/SSD/docker/calendar_stream/postgres.
# Password comes from Docker secret: /mnt/SSD/docker/.secrets/DB_PASSWORD.txt
DB_NAME=calendar_stream
DB_USER=ccs
