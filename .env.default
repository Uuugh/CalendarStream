# ============================================================
#  CalendarStream settings (.env). Every setting is optional and shows its default.
#  No passwords here: the database password is in .secrets/DB_PASSWORD.txt, and the logins
#  (status page, CCS+, Google) are set on the status page.
# ============================================================

# --- Storage ---
# optional: folder for .secrets/ and the database (calendar_stream/postgres), e.g. /mnt/SSD/docker.
#           Default: the folder this file and docker-compose.yml are in.
#MNT_DOCKER=

# --- Recommended ---
# optional: your time zone; CCS+ times are shown in it. Default: America/Chicago
TZ=America/New_York

# --- Docker ---
# optional: which image to run. latest = stable, beta = newest, or an exact version
#           such as 0.1.1. Default: latest
IMAGE_TAG=latest
# optional: user and group the app runs as. Default: 1000 and 100
PUID=1000
GUID=100
# optional: restart policy: no | always | unless-stopped | on-failure. Default: unless-stopped
RESTART=unless-stopped

# --- Reverse proxy ---
# (The public address is set on the status page: ☰ Settings → Public address.)
# optional: behind a reverse proxy (Nginx Proxy Manager, Traefik, Caddy, Cloudflare Tunnel…), its
#           address or Docker network, e.g. 172.18.0.0/16. CalendarStream then sees the visitor's
#           address (for the login lockout) and https. Default: 127.0.0.1 (no proxy is believed).
#FORWARDED_ALLOW_IPS=172.18.0.0/16

# --- Schedule ---
# optional: minutes between CCS+ checks, 15–1440. Default: 60.
#           “Check for changes every” in the CCS+ Calendar Sync box overrides this.
SYNC_INTERVAL_MINUTES=60
# optional: the CCS+ "Copy link" URL. Default: the standard United Calendar Sync link.
#           A link saved in the CCS+ Calendar Sync box overrides this.
CCS_CALENDAR_URL=https://ccsplus.ual.com/calendarsyncapi/api/Calendar/GetCalendar
# optional: calendar name in Google and the feed. Default: United CCS Schedule.
#           (edit) on the status page overrides this.
CALENDAR_NAME=United CCS Schedule
# optional: items with a start time but no end time: a number of hours (1, 1.5, …)
#           or allday. Default: 1
DEFAULT_EVENT_HOURS=1
# optional: show events lasting exactly 24 h (48 h, …) as all-day: true | false. Default: true
ALLDAY_24H=true

# --- Feed ---
# optional: secret part of the feed and subscribe links. Default: made once and saved in
#           the database. Set it only to keep an old link, or change it to cut off everyone
#           who has the current one.
FEED_TOKEN=

# --- Database ---
# optional: Postgres database name and user. Defaults: calendar_stream and ccs.
#           Only used the first time Postgres starts; changing them later breaks the connection.
DB_NAME=calendar_stream
DB_USER=ccs
