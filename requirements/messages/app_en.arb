  "theMenuOnTheLeft": "✓ The menu on the left now shows Branding, Audience, Clients and Data access.",
  "allowCalendarAccessOpenData": "<b>Allow calendar access.</b> Open <a href=\"https://console.cloud.google.com/auth/scopes\" target=\"_blank\" rel=\"noopener\">Data access</a> › <b>Add or remove scopes</b> › under “Manually add scopes”, paste",
  "letYourselfSignInDo": "<b>Let yourself sign in. Do this now, or Connect fails with “403 access_denied”.</b> Open <a href=\"https://console.cloud.google.com/auth/audience\" target=\"_blank\" rel=\"noopener\">Audience</a> › <b>Publish app</b> › <b>Confirm</b>.",
  "canTPublishTheButton": "Can’t publish (the button is greyed out)? On the same page, under <b>Test users</b>, press <b>+ Add users</b>, enter the Gmail address you’ll connect with, and press <b>Save</b>. In Testing, Google makes you press Connect again every 7 days.",
  "createTheClientOpenClients": "<b>Create the client.</b> Open <a href=\"https://console.cloud.google.com/auth/clients\" target=\"_blank\" rel=\"noopener\">Clients</a> › <b>Create client</b> › Application type: <b>Web application</b> › Name: <code>CalendarStream</code>. Leave <b>Authorized JavaScript origins</b> empty; under <b>Authorized redirect URIs</b> press <b>+ Add URI</b> and paste this (use the copy button, don’t type it):",
  "copyBothKeysNowGoogle": "<b>Copy both keys now.</b> Google shows the <b>Client secret only once</b>, in a pop-up. Copy the Client ID and the Client secret into the boxes above and press <b>Save</b>.",
  "youNowSeeValidatedClosed": "✓ You now see “✓ Validated”. Closed the pop-up already? Open Clients › CalendarStream › <b>Add secret</b>.",
  "connectWaitAbout5Minutes": "<b>Connect.</b> Wait about 5 minutes (Google can take that long to apply changes), then press <b>Connect Google Calendar</b> above.",
  "ifGoogleShowsAnError": "If Google shows an error",
  "error400RedirectUriMismatch": "<b>Error 400: redirect_uri_mismatch</b>: open Clients › CalendarStream › <b>Authorized redirect URIs</b> (not JavaScript origins) › <b>+ Add URI</b> › paste the address from step 6 › <b>Save</b>, and wait 5 minutes. If that address is misspelled, fix ☰ Settings → Public address first.",
  "error403AccessDeniedHas": "<b>Error 403: access_denied</b> (“has not completed the Google verification process”, “developer-approved testers”): step 5: publish the app, or add the exact Gmail address you sign in with under <b>Test users</b>.",
  "googleHasnTVerifiedThis": "<b>“Google hasn’t verified this app”</b>: not an error. Press <b>Continue</b> (or <b>Advanced</b> › <b>Go to CalendarStream</b>).",
  "error401InvalidClientThe": "<b>Error 401: invalid_client</b>: the ID or secret is wrong or from another project. Copy both again, or make a new secret with Clients › CalendarStream › <b>Add secret</b>.",
  "error401DeletedClientThe": "<b>Error 401: deleted_client</b>: the client was deleted (Google deletes clients unused for 6 months). Restore it on the Clients page within 30 days, or do step 6 again.",
  "askedToConnectAgainAfter": "<b>Asked to Connect again after a week</b>: the app is still in Testing. Publish it (step 5).",
  "enterTheSetupCodeThe": "Enter the <b>setup code</b> the installer printed at the end. Lost it? On the server, in the folder with docker-compose.yml, run",
  "googleSignInWasCancelled2": "Google sign-in was cancelled or refused. If Google said the app is only for testers, add your Gmail address under Audience → Test users in Google Cloud.",
  "signInWrong": "That user name or password isn't right.",
